# Step 4: install Maven from archive.apache.org. apt's
# Maven (3.8.7 on noble LTS) fails most projects'
# requireMavenVersion enforcer rule. Apache's archive is
# content-addressable + immutable, so the SHA512 pin is
# durable indefinitely.
RUN set -eux \
 && curl -fsSL 'https://archive.apache.org/dist/maven/maven-3/3.9.15/binaries/apache-maven-3.9.15-bin.tar.gz' -o /tmp/maven.tgz \
 && echo '33d81e0ec785f0207e3e5e3ffb61863e1dca5784c15ac3fb5ff105f69cffbea484eb8d473ea60467a63f7b0570eef8622f2fed8eee96acbe668aa313391cddb3  /tmp/maven.tgz' | sha512sum -c - \
 && mkdir -p /opt/maven \
 && tar -xzf /tmp/maven.tgz -C /opt/maven --strip-components=1 \
 && ln -sf /opt/maven/bin/mvn /usr/local/bin/mvn \
 && rm -f /tmp/maven.tgz

# Step 5: pre-populate the Maven local repository.
# Each artifact is downloaded from repo1.maven.org and
# SHA256-verified before landing in /root/.m2/repository.
# Maven Central is content-addressable + immutable by
# convention, so a (groupId, artifactId, version) tuple
# resolves to one specific file forever; the SHA256
# stamps that immutability into this Dockerfile.
#
# Chunked into batches so each RUN stays under Linux's
# MAX_ARG_STRLEN (~128 KB) AND so the layer count stays
# under Docker's 127-layer cap. Batches of 250 hold us
# at ~100 KB per RUN; for keycloak-class projects with
# ~5000+ resolved artifacts that's ~20 layers, well
# under the Docker limit. Smaller batches (e.g. 100)
# blew the layer cap on Keycloak; 250 is the chosen
# middle ground — still under MAX_ARG_STRLEN with
# margin.
RUN mkdir -p /root/.m2/repository
# Maven pin batch 1 (entries 1-250 of 1233)
